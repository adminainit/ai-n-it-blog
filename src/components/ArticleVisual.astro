---
interface Props {
  post: any;
  featured?: boolean;
  index?: number;
}

const { post, featured = false, index = 0 } = Astro.props;
const palettes = [
  ['var(--site-primary)', 'var(--site-secondary)', 'var(--site-accent)'],
  ['var(--site-primary)', 'color-mix(in srgb, var(--site-secondary) 68%, #1685d8)', 'var(--site-accent)'],
  ['color-mix(in srgb, var(--site-primary) 84%, #59451b)', 'color-mix(in srgb, var(--site-accent) 60%, #c8a84e)', 'var(--site-secondary)'],
  ['color-mix(in srgb, var(--site-primary) 82%, #5a283e)', 'var(--site-accent)', 'var(--site-secondary)'],
];
const palette = palettes[index % palettes.length];
const words = post.data.title.trim().split(/\s+/);
const initials = words.slice(0, 2).map((word: string) => word[0]).join('').toUpperCase();
const label = post.data.tags?.[0] || 'Perspective';
const style = `--visual-ink:${palette[0]};--visual-accent:${palette[1]};--visual-signal:${palette[2]}`;
---

<div class:list={['article-visual', { featured }]} style={style} aria-hidden="true">
  <div class="visual-grid"></div>
  <div class="visual-orbit visual-orbit-one"></div>
  <div class="visual-orbit visual-orbit-two"></div>
  <span class="visual-index">{String(index + 1).padStart(2, '0')}</span>
  <div class="visual-monogram">{initials}</div>
  <span class="visual-label">{label}</span>
  <svg class="visual-signal" viewBox="0 0 210 70" fill="none">
    <path d="M2 58c30 0 27-33 57-33 27 0 31 20 54 20 29 0 30-42 61-42 18 0 21 16 34 16" />
    <circle cx="59" cy="25" r="4" />
    <circle cx="174" cy="3" r="4" />
  </svg>
</div>

<style>
  .article-visual {
    position: relative;
    min-height: 13rem;
    height: 100%;
    overflow: hidden;
    isolation: isolate;
    color: white;
    background:
      radial-gradient(circle at 78% 20%, color-mix(in srgb, var(--visual-signal) 58%, transparent), transparent 28%),
      linear-gradient(145deg, var(--visual-accent), var(--visual-ink) 67%);
  }

  .article-visual.featured {
    min-height: 23rem;
  }

  .visual-grid {
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: .16;
    background-image:
      linear-gradient(rgb(255 255 255 / .45) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / .45) 1px, transparent 1px);
    background-size: 38px 38px;
    transform: perspective(280px) rotateX(54deg) scale(1.4) translateY(28%);
  }

  .visual-orbit {
    position: absolute;
    border: 1px solid rgb(255 255 255 / .28);
    border-radius: 999px;
  }

  .visual-orbit::after {
    content: '';
    position: absolute;
    width: .7rem;
    height: .7rem;
    border-radius: 999px;
    background: var(--visual-signal);
    box-shadow: 0 0 0 .35rem color-mix(in srgb, var(--visual-signal) 20%, transparent);
  }

  .visual-orbit-one {
    width: 15rem;
    height: 15rem;
    right: -3rem;
    top: -4rem;
  }

  .visual-orbit-one::after {
    left: 1rem;
    top: 9rem;
  }

  .visual-orbit-two {
    width: 9rem;
    height: 9rem;
    left: -3rem;
    bottom: -4rem;
  }

  .visual-orbit-two::after {
    right: .35rem;
    top: 2rem;
  }

  .visual-index,
  .visual-label {
    position: absolute;
    z-index: 2;
    font-family: 'IBM Plex Mono', monospace;
    font-size: .66rem;
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  .visual-index {
    top: 1.25rem;
    right: 1.25rem;
    opacity: .68;
  }

  .visual-label {
    left: 1.25rem;
    bottom: 1.25rem;
    padding: .45rem .7rem;
    border: 1px solid rgb(255 255 255 / .28);
    border-radius: 999px;
    background: rgb(7 26 43 / .35);
    backdrop-filter: blur(8px);
  }

  .visual-monogram {
    position: absolute;
    left: 50%;
    top: 50%;
    display: grid;
    width: 5.6rem;
    height: 5.6rem;
    place-items: center;
    transform: translate(-50%, -50%) rotate(-7deg);
    border: 1px solid rgb(255 255 255 / .4);
    border-radius: 1.7rem;
    color: var(--visual-ink);
    background: rgb(245 240 232 / .92);
    box-shadow: 0 1.4rem 3rem rgb(2 12 20 / .28);
    font-family: 'Newsreader', serif;
    font-size: 2rem;
    font-weight: 600;
  }

  .featured .visual-monogram {
    width: 7.5rem;
    height: 7.5rem;
    border-radius: 2.2rem;
    font-size: 2.75rem;
  }

  .visual-signal {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    width: 58%;
    opacity: .6;
    stroke: white;
    stroke-width: 1.5;
  }

  .visual-signal circle {
    fill: var(--visual-signal);
    stroke: none;
  }
</style>
