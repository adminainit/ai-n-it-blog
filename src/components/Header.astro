---
import { siteConfig } from '../../site.config';
import ThemeToggle from './ThemeToggle';
import Search from 'astro-pagefind/components/Search.astro';
import { sitePath } from '../utils/urls';
const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---

<header class="h-16 flex items-center justify-between px-4 md:px-10 bg-white/80 dark:bg-slate-950/80 backdrop-blur-md border-b border-slate-200 dark:border-slate-800 sticky top-0 z-50 transition-colors duration-200">
  <div class="flex items-center gap-2">
    <a href={import.meta.env.BASE_URL} class="flex items-center gap-2 text-xl font-extrabold tracking-tighter text-slate-900 dark:text-white transition-all duration-300 hover:text-indigo-600 dark:hover:text-indigo-400">
      {siteConfig.branding?.logoImage ? (
        <img src={sitePath(siteConfig.branding.logoImage)} alt="Logo" class="max-h-12 max-w-[200px] w-auto object-contain" />
      ) : (
        <div class="w-8 h-8 bg-indigo-600 rounded-lg flex items-center justify-center shrink-0">
          <div class="w-4 h-4 border-2 border-white rotate-45"></div>
        </div>
      )}
      <span class="hidden sm:block">{siteConfig.branding?.logoText || siteConfig.title}</span>
    </a>
  </div>
  
  <div class="flex-1 max-w-sm mx-6 hidden lg:block">
    <Search id="search" className="pagefind-ui" uiOptions={{ showImages: false, showEmptyFilters: true }} />
  </div>

  <nav class="flex items-center gap-6 md:gap-8 text-sm font-medium text-slate-600 dark:text-slate-300">
    <a href={import.meta.env.BASE_URL} class="hover:text-slate-900 dark:hover:text-white transition-colors duration-300">Home</a>
    <a href={baseUrl + 'blog'} class="hover:text-slate-900 dark:hover:text-white transition-colors duration-300">Blog</a>
    <ThemeToggle client:load />
  </nav>
</header>

<style is:global>
  .pagefind-ui {
    --pagefind-ui-scale: 0.8;
    --pagefind-ui-primary: #4f46e5;
    --pagefind-ui-text: #1e293b;
    --pagefind-ui-background: #ffffff;
    --pagefind-ui-border: #e2e8f0;
    --pagefind-ui-tag: #f8fafc;
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 0.5rem;
  }

  .dark .pagefind-ui {
    --pagefind-ui-text: #f1f5f9;
    --pagefind-ui-background: #0f172a;
    --pagefind-ui-border: #1e293b;
    --pagefind-ui-tag: #020617;
  }
</style>
