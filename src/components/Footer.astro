---
import { siteConfig } from '../../site.config';
---

<footer class="bg-white dark:bg-slate-950 border-t border-slate-200 dark:border-slate-800 px-10 py-6 flex flex-col md:flex-row items-center justify-between gap-6 transition-colors duration-200 mt-auto">
  <div class="flex items-center gap-6">
    <p class="text-xs font-semibold text-slate-400 italic">
      © {new Date().getFullYear()} {siteConfig.author}. Built with Astro & MDX.
    </p>
  </div>
  
  <div class="flex gap-4">
    {siteConfig.socialLinks.map(link => (
      <a 
        href={link.url}
        target="_blank"
        rel="noopener noreferrer"
        class="text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors duration-300"
      >
        {link.name}
      </a>
    ))}
  </div>
</footer>
