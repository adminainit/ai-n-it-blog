---
import { siteConfig } from '../../site.config';
import { sitePath } from '../utils/urls';
---

<footer class="mt-auto border-t border-slate-200 bg-[#f0ede6] px-4 py-8 transition-colors duration-200 dark:border-slate-800 dark:bg-slate-950 sm:px-6 md:px-10">
  <div class="mx-auto flex max-w-[1380px] flex-col items-start justify-between gap-6 md:flex-row md:items-center">
  <div class="flex items-center gap-4">
    {siteConfig.branding?.logoImage && <img src={sitePath(siteConfig.branding.logoImage)} alt="" class="h-9 w-9 object-contain" />}
    <div>
      <p class="text-sm font-extrabold tracking-[-0.03em] text-slate-900 dark:text-white">{siteConfig.branding?.logoText || siteConfig.title}</p>
      <p class="mt-0.5 text-[10px] font-medium uppercase tracking-[0.1em] text-slate-500">
        © {new Date().getFullYear()} {siteConfig.author}. {siteConfig.footer?.builtWithText || 'Built with Astro & MDX.'}
      </p>
    </div>
  </div>

  <div class="flex gap-5">
    {(siteConfig.socialLinks || []).map(link => (
      <a 
        href={link.url}
        target="_blank"
        rel="noopener noreferrer"
        class="text-[10px] font-bold uppercase tracking-[0.12em] text-slate-500 transition-colors duration-300 hover:text-teal-700 dark:text-slate-400 dark:hover:text-teal-300"
      >
        {link.name}
      </a>
    ))}
  </div>
  </div>
</footer>
