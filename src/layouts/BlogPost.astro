---
import Layout from './Layout.astro';
import { siteConfig } from '../../site.config';
import { Image } from 'astro:assets';
import { sitePath } from '../utils/urls';

const { frontmatter } = Astro.props;

const currentUrl = new URL(Astro.url.pathname, Astro.site || siteConfig.url).toString();
const twitterShareUrl = `https://twitter.com/intent/tweet?url=${encodeURIComponent(currentUrl)}&text=${encodeURIComponent(frontmatter.title)}`;
const linkedinShareUrl = `https://www.linkedin.com/shareArticle?mini=true&url=${encodeURIComponent(currentUrl)}&title=${encodeURIComponent(frontmatter.title)}`;

const formattedDate = new Date(frontmatter.date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
}).toUpperCase();
---

<Layout title={`${frontmatter.title} | ${siteConfig.title}`} description={frontmatter.description}>
  <article class="max-w-3xl mx-auto px-6 md:px-10 py-12 md:py-16 mb-20 w-full">
    <header class="mb-10 text-left">
      <div class="flex flex-wrap items-center gap-2 mb-4">
        <span class="text-[10px] font-bold text-indigo-600 dark:text-indigo-400">
          {formattedDate}
        </span>
        {frontmatter.tags && frontmatter.tags.map((tag: string) => (
          <>
            <span class="text-slate-300 dark:text-slate-600">•</span>
            <span class="font-mono text-[10px] uppercase font-bold text-slate-500 dark:text-slate-400">
              {tag}
            </span>
          </>
        ))}
      </div>
      <h1 class="text-4xl md:text-5xl font-extrabold leading-[1.1] tracking-tight text-slate-900 dark:text-white mb-6">
        {frontmatter.title}
      </h1>
      <p class="text-base text-slate-500 dark:text-slate-400 leading-relaxed">
        {frontmatter.description}
      </p>
    </header>

    {frontmatter.image && (
      <div class="mb-12 rounded-2xl border border-slate-200 dark:border-slate-800 overflow-hidden bg-slate-100 dark:bg-slate-900">
        {typeof frontmatter.image === 'string' ? (
          <img
            src={sitePath(frontmatter.image)}
            alt={frontmatter.title}
            class="w-full aspect-video object-cover"
            referrerpolicy="no-referrer"
          />
        ) : (
          <Image 
            src={frontmatter.image} 
            alt={frontmatter.title} 
            width={1200}
            class="w-full aspect-video object-cover"
          />
        )}
      </div>
    )}

    <div class="prose prose-slate dark:prose-invert max-w-none prose-headings:font-bold prose-headings:tracking-tight prose-a:text-indigo-600 dark:prose-a:text-indigo-400 prose-img:rounded-xl prose-img:border prose-img:border-slate-200 dark:prose-img:border-slate-800">
      <slot />
    </div>

    <footer class="mt-16 pt-8 border-t border-slate-200 dark:border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs font-bold text-slate-400 uppercase tracking-widest">Share Article</p>
      <div class="flex gap-2">
        <a href={twitterShareUrl} target="_blank" rel="noopener noreferrer" class="w-8 h-8 flex items-center justify-center rounded border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/></svg>
        </a>
        <a href={linkedinShareUrl} target="_blank" rel="noopener noreferrer" class="w-8 h-8 flex items-center justify-center rounded border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-300 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
           <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        </a>
      </div>
    </footer>
  </article>
</Layout>
