---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';
import ThemeManager from '../components/ThemeManager.astro';
import { ClientRouter } from 'astro:transitions';
import { siteConfig } from '../../site.config';
import { fontStack, getTypographyScalePreset, typographySizeLimits } from '../../brand.options.js';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "A polished MDX blog." } = Astro.props;
const primaryColor = siteConfig.theme?.hexColors?.primary || '#071a2b';
const secondaryColor = siteConfig.theme?.hexColors?.secondary || '#149e92';
const accentColor = siteConfig.theme?.hexColors?.accent || '#ff825c';
const headingFont = siteConfig.branding?.typography?.headingFont || 'Newsreader';
const bodyFont = siteConfig.branding?.typography?.bodyFont || 'Manrope';
const typographyPreset = getTypographyScalePreset(siteConfig.branding?.typography?.sizePreset || 'balanced');
const configuredSizes = { ...typographyPreset.sizes, ...(siteConfig.branding?.typography?.sizes || {}) };
const safeSize = (key: keyof typeof typographySizeLimits) => {
  const limits = typographySizeLimits[key];
  const value = Number(configuredSizes[key]);
  return Number.isFinite(value) ? Math.min(limits.max, Math.max(limits.min, value)) : typographyPreset.sizes[key];
};
const themeVariables = [
  `--site-primary:${primaryColor}`,
  `--site-secondary:${secondaryColor}`,
  `--site-accent:${accentColor}`,
  `--site-heading-font:${fontStack(headingFont)}`,
  `--site-body-font:${fontStack(bodyFont)}`,
  `--site-body-size:${safeSize('body')}px`,
  `--site-eyebrow-size:${safeSize('eyebrow')}px`,
  `--site-button-size:${safeSize('button')}px`,
  `--site-hero-title-size:${safeSize('heroTitle')}px`,
  `--site-hero-body-size:${safeSize('heroBody')}px`,
  `--site-section-title-size:${safeSize('sectionTitle')}px`,
  `--site-card-title-size:${safeSize('cardTitle')}px`,
].join(';');
---

<!doctype html>
<html lang="en" class="antialiased" style={themeVariables}>
  <head>
    <SEO title={title} description={description} />
    <ThemeManager />
    <ClientRouter />
  </head>
  <body class="bg-[#f7f5f0] dark:bg-slate-950 text-slate-900 dark:text-slate-100 min-h-screen flex flex-col transition-colors duration-200">
    <Header />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />
  </body>
</html>
