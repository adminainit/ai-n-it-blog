---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero';
import PostCard from '../components/PostCard.astro';
import { siteConfig } from '../../site.config';
const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';

const allPosts = await getCollection('posts', ({ data }) => {
  return import.meta.env.PROD ? data.draft !== true : true;
});
const sortedPosts = allPosts.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const leadPost = sortedPosts[0];
const supportingPosts = sortedPosts.slice(1, 3);
const recentPosts = sortedPosts.slice(3, 6);
---

<Layout title={siteConfig.title} description={siteConfig.description}>
  <div class="mx-auto flex max-w-[1380px] flex-col gap-20 px-4 py-6 sm:px-6 md:py-10 lg:px-10">
    <Hero postCount={sortedPosts.length} client:load />

    {leadPost && (
      <section id="latest-insights" class="scroll-mt-24">
        <header class="mb-8 flex flex-col gap-5 border-b border-slate-300/80 pb-6 sm:flex-row sm:items-end sm:justify-between dark:border-slate-700">
          <div>
            <p class="mb-3 font-mono text-[10px] font-semibold uppercase tracking-[0.18em] text-[var(--site-secondary)]">{siteConfig.homePage?.latestEyebrow || 'The intelligence desk'}</p>
            <h2 class="text-balance font-display text-4xl font-semibold tracking-[-0.025em] text-slate-950 sm:text-5xl dark:text-white">{siteConfig.homePage?.latestTitle || 'Latest perspectives'}</h2>
          </div>
          <div class="flex items-center gap-4">
            <span class="hidden text-sm text-slate-500 md:block">{siteConfig.homePage?.latestDescription || 'Every current article, visible at a glance.'}</span>
            <a href={baseUrl + 'blog'} class="inline-flex items-center gap-2 text-xs font-extrabold uppercase tracking-[0.12em] text-slate-900 transition hover:text-teal-700 dark:text-white dark:hover:text-teal-300">
              {siteConfig.homePage?.latestLinkText || 'View archive'} <span aria-hidden="true">↗</span>
            </a>
          </div>
        </header>

        <div class="grid gap-6 lg:grid-cols-[1.32fr_.68fr]">
          <PostCard post={leadPost} featured={true} index={0} />
          {supportingPosts.length > 0 && (
            <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-1">
              {supportingPosts.map((post, index) => (
                <PostCard post={post} index={index + 1} />
              ))}
            </div>
          )}
        </div>
      </section>
    )}
  </div>

  {recentPosts.length > 0 && (
    <section class="mx-auto flex max-w-[1380px] flex-col gap-6 px-4 pb-20 sm:px-6 lg:px-10">
      <div class="flex items-end justify-between border-b border-slate-300/80 pb-5 dark:border-slate-700">
        <div>
          <p class="mb-2 font-mono text-[10px] font-semibold uppercase tracking-[0.18em] text-[var(--site-accent)]">{siteConfig.homePage?.archiveEyebrow || 'From the archive'}</p>
          <h2 class="font-display text-3xl font-semibold text-slate-950 dark:text-white">{siteConfig.homePage?.archiveTitle || 'More to explore'}</h2>
        </div>
        <a href={baseUrl + 'blog'} class="text-xs font-extrabold uppercase tracking-[0.12em] text-slate-900 hover:text-[var(--site-secondary)] dark:text-white">{siteConfig.homePage?.archiveLinkText || 'View all'}</a>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {recentPosts.map((post, index) => (
          <PostCard post={post} index={index + 3} />
        ))}
      </div>
    </section>
  )}
</Layout>
