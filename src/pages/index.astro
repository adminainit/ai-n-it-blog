---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero';
import PostCarousel from '../components/PostCarousel';
import PostCard from '../components/PostCard.astro';
import { siteConfig } from '../../site.config';

const allPosts = await getCollection('posts', ({ data }) => {
  return import.meta.env.PROD ? data.draft !== true : true;
});

const sortedPosts = allPosts.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const featuredPosts = sortedPosts.slice(0, 3);
const recentPosts = sortedPosts.slice(3, 6);
---

<Layout title={siteConfig.title} description={siteConfig.description}>
  <div class="max-w-[1200px] mx-auto px-6 md:px-10 py-12 flex flex-col lg:flex-row gap-12">
    <div class="lg:w-1/3 flex flex-col justify-center">
      <Hero client:load />
    </div>
    
    {featuredPosts.length > 0 && (
      <div class="lg:w-2/3 h-[380px]">
        <PostCarousel posts={featuredPosts} client:load />
      </div>
    )}
  </div>
  
  {recentPosts.length > 0 && (
    <section class="max-w-[1200px] mx-auto px-6 md:px-10 py-12 flex flex-col gap-4">
      <div class="flex justify-between items-end border-b border-slate-200 dark:border-slate-800 pb-2">
        <h4 class="text-sm font-bold uppercase tracking-widest text-slate-400">Recent Entries</h4>
        <a href="/blog" class="text-xs font-semibold text-indigo-600 dark:text-indigo-400 hover:underline">View All Archive</a>
      </div>
        
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 pt-4">
        {recentPosts.map(post => (
          <PostCard post={post} />
        ))}
      </div>
    </section>
  )}
</Layout>
