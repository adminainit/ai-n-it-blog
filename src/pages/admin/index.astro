---
import { createRequire } from 'module';
const require = createRequire(import.meta.url);
import AdminApp from '../../components/AdminApp';
import { siteConfig } from '../../../site.config';
import ThemeManager from '../../components/ThemeManager.astro';

import '../../styles/global.css';

import matter from 'gray-matter';
import fs from 'fs';
import path from 'path';

let postsData = [];
try {
  const dbPath = path.resolve('./data/local.db');
  if (fs.existsSync(dbPath)) {
    const Database = require('better-sqlite3');
    const db = new Database(dbPath);
    const posts = db.prepare('SELECT id, content FROM posts').all();
    postsData = posts.map(post => {
      const parsed = matter(post.content);
      return {
        id: post.id,
        title: parsed.data.title || 'Untitled',
        date: parsed.data.date || new Date().toISOString(),
        draft: parsed.data.draft || false,
        rawContent: post.content
      };
    });
    db.close();
  }
} catch (e) {
  console.error("Error loading posts for admin:", e);
}
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Portal | {siteConfig.branding.logoText}</title>
    <ThemeManager />
  </head>
  <body class="bg-white dark:bg-slate-950 font-sans text-slate-900 dark:text-slate-100 min-h-screen flex flex-col transition-colors duration-200">
    <AdminApp initialPosts={postsData} client:only="react" />
  </body>
</html>
