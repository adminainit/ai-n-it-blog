---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../../site.config';
const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<Layout title={`${siteConfig.notFoundPage?.title || 'Page not found'} | ${siteConfig.title}`} description={siteConfig.notFoundPage?.description || 'The requested page could not be found.'}>
  <section class="max-w-2xl mx-auto px-6 py-24 text-center">
    <p class="font-mono text-xs font-bold uppercase tracking-[0.3em] text-indigo-600 dark:text-indigo-400">404</p>
    <h1 class="mt-5 text-4xl md:text-6xl font-extrabold tracking-tight text-slate-900 dark:text-white">{siteConfig.notFoundPage?.title || 'Page not found'}</h1>
    <p class="mt-5 text-slate-500 dark:text-slate-400">{siteConfig.notFoundPage?.description || 'The requested page could not be found.'}</p>
    <div class="mt-9 flex flex-col sm:flex-row justify-center gap-3">
      <a href={baseUrl} class="px-6 py-3 rounded-xl bg-[var(--site-primary)] text-white text-sm font-bold hover:brightness-110">{siteConfig.notFoundPage?.homeButtonText || 'Go home'}</a>
      <a href={`${baseUrl}blog/`} class="px-6 py-3 rounded-xl border border-slate-300 dark:border-slate-700 text-slate-700 dark:text-slate-200 text-sm font-bold hover:bg-slate-100 dark:hover:bg-slate-800">{siteConfig.notFoundPage?.blogButtonText || 'Browse articles'}</a>
    </div>
  </section>
</Layout>
