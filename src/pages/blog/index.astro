---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import { siteConfig } from '../../../site.config';

const allPosts = await getCollection('posts', ({ data }) => {
  return import.meta.env.PROD ? data.draft !== true : true;
});

const sortedPosts = allPosts.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Layout title={`${siteConfig.blogPage?.seoTitle || 'Blog'} | ${siteConfig.title}`} description={siteConfig.blogPage?.seoDescription || siteConfig.description}>
  <div class="mx-auto max-w-[1380px] px-4 py-10 sm:px-6 md:py-16 lg:px-10">
    <header class="relative mb-12 overflow-hidden rounded-[2rem] bg-[var(--site-primary)] px-7 py-10 text-white shadow-[0_30px_90px_rgba(7,26,43,.2)] sm:px-10 md:rounded-[2.5rem] md:px-14 md:py-14">
      <div class="surface-grid absolute inset-0 opacity-80"></div>
      <div class="absolute -right-16 -top-20 h-72 w-72 rounded-full bg-teal-400/20 blur-3xl"></div>
      <div class="relative max-w-3xl">
        <p class="mb-5 font-mono text-[10px] font-semibold uppercase tracking-[0.18em] text-white/70">{siteConfig.blogPage?.eyebrow || 'Knowledge library'} · {sortedPosts.length} {siteConfig.blogPage?.storyCountLabel || 'stories'}</p>
        <h1 class="text-balance font-display text-5xl font-semibold leading-[.98] tracking-[-0.035em] text-[#f5f0e8] md:text-7xl">
          {siteConfig.blogPage?.title || 'Intelligence worth putting to work.'}
        </h1>
        <p class="mt-6 max-w-2xl text-sm leading-7 text-slate-300 md:text-base">
          {siteConfig.blogPage?.description || siteConfig.description}
        </p>
      </div>
    </header>

    {sortedPosts.length > 0 ? (
      <div class="grid grid-cols-1 gap-7 md:grid-cols-2 lg:grid-cols-3">
        {sortedPosts.map((post, index) => (
          <PostCard post={post} index={index} />
        ))}
      </div>
    ) : (
      <div class="rounded-[2rem] border border-slate-200 bg-white py-20 text-center dark:border-slate-800 dark:bg-slate-900">
        <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-2">{siteConfig.blogPage?.emptyTitle || 'No posts found'}</h2>
        <p class="text-slate-500 dark:text-slate-400">{siteConfig.blogPage?.emptyDescription || 'Check back later for new content!'}</p>
      </div>
    )}
  </div>
</Layout>
